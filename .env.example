# ── Competition API Auth ─────────────────────────────────────────────────
# Bearer Token 认证（必填，比赛评测用）
KAFU_API_TOKEN=your_token_here

# ── LLM Backend ─────────────────────────────────────────────────────────
LLM_API_KEY=your_api_key
LLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
LLM_MODEL=mimo-v2.5-pro
LLM_VISION_MODEL=mimo-v2.5-pro

# ── DashScope (Alibaba Cloud AI) ────────────────────────────────────────
DASHSCOPE_API_KEY=your_dashscope_key
INDUSTRY_AGENT_DASHSCOPE_ENABLED=1
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_RERANK_MODEL=qwen3-rerank

# ── Milvus Vector Store ────────────────────────────────────────────────
VECTOR_BACKEND=milvus
MILVUS_URI=https://in03-xxx.zillizcloud.cn
MILVUS_TOKEN=your_zilliz_token
MILVUS_COLLECTION=chunk_vectors

# ── Retrieval Mode ──────────────────────────────────────────────────────
RETRIEVAL_MODE=hybrid

# ── Agent Backend ───────────────────────────────────────────────────────
INDUSTRY_AGENT_AGENT_BACKEND=service
